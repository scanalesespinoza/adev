{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A-Dev Hardness Policy Record",
  "description": "Vendor-neutral structural contract for a durable Hardness policy. This schema validates record shape, not runtime enforcement or behavioral outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "level",
    "scope",
    "authority",
    "precedence",
    "rationale",
    "exceptions",
    "evidence",
    "owner",
    "review",
    "expiry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HD-[A-Z][A-Z0-9-]*-[0-9]{3}$",
      "description": "Stable, human-readable policy identifier."
    },
    "statement": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "enum": ["MUST", "SHOULD", "MAY"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "tasks", "roles", "files", "tools", "environments"],
      "properties": {
        "repositories": { "$ref": "#/definitions/nonEmptyStringArray" },
        "tasks": { "$ref": "#/definitions/nonEmptyStringArray" },
        "roles": { "$ref": "#/definitions/nonEmptyStringArray" },
        "files": { "$ref": "#/definitions/nonEmptyStringArray" },
        "tools": { "$ref": "#/definitions/nonEmptyStringArray" },
        "environments": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "level"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "enum": ["safety", "user", "repository", "overlay", "skill", "general"] }
      }
    },
    "precedence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRank", "priority", "tieBreaker"],
      "properties": {
        "authorityRank": { "type": "integer", "minimum": 1, "maximum": 6 },
        "priority": { "type": "integer", "minimum": 0 },
        "tieBreaker": { "type": "string", "enum": ["narrower-scope", "newer-review", "escalate"] }
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "disposition"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "enum": ["not-applicable", "requires-approval", "escalate"] }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "retention"],
      "properties": {
        "requirements": { "$ref": "#/definitions/nonEmptyStringArray" },
        "retention": { "type": "string", "enum": ["report", "repository-record", "external-record"] }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reviewer"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "dueOn"],
      "properties": {
        "trigger": { "type": "string", "minLength": 1 },
        "dueOn": { "type": "string", "format": "date" }
      }
    },
    "expiry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiresOn", "action"],
      "properties": {
        "expiresOn": { "type": "string", "format": "date" },
        "action": { "type": "string", "enum": ["review", "retire", "escalate"] }
      }
    }
  },
  "definitions": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
